APP_NAME=solidtime
APP_VERSION=0.0.0
APP_BUILD=0
VITE_APP_NAME=solidtime
APP_ENV=production
APP_DEBUG=false
APP_FORCE_HTTPS=true
OCTANE_SERVER=frankenphp
PAGINATION_PER_PAGE_DEFAULT=10000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql

# Database backups (the schedule can be changed later in /admin)
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_HOST_PATH=/mnt/solidtime_backups
DATABASE_BACKUP_ROOT_PATH=/backups
DATABASE_BACKUP_TIME=02:00
DATABASE_BACKUP_TIMEZONE=UTC
DATABASE_BACKUP_RETENTION_DAYS=30
DATABASE_BACKUP_TIMEOUT_SECONDS=1800
